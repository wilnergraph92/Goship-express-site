# ==========================================================================
#  Goship Express — réglages du serveur de goshipexpress.net (Hostinger)
# ==========================================================================
#  Écrit par outils/generateur/build.py (HTACCESS) : changez-le là.
#  Hostinger lit ce fichier à chaque requête ; GitHub Pages l'ignore, et
#  deploy.yml ne l'y envoie pas. Il part sur Hostinger avec le site, par la
#  branche « hostinger » (voir deploy.yml, job « envoyer-hostinger »).
# ==========================================================================

# Une adresse inconnue montre la page « introuvable » du site, pas celle de
# l'hébergeur. Ses liens commencent par « / » : elle s'affiche juste à
# n'importe quelle profondeur (/en/…, /ht/…).
ErrorDocument 404 /404.html

# --- Une seule adresse : goshipexpress.net, sans « www » --------------------
#  www.goshipexpress.net servait les mêmes pages : pour Google, deux sites en
#  double ; pour le client, deux sessions (connecté sur l'un, pas sur l'autre).
#  Renvoi définitif (301), adresse, paramètres et ancre gardés. En premier :
#  les règles suivantes ne voient plus que le domaine nu.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.goshipexpress\.net$ [NC]
  RewriteRule ^ https://goshipexpress.net%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- Les fichiers de travail ne sont jamais servis aux visiteurs ----------
#  Ils ne sont pas envoyés, mais si l'un arrivait par erreur, il resterait
#  caché. Le dossier .git est celui que Hostinger garde pour suivre la
#  branche « hostinger ».
#  Toujours « 404 », jamais « 403 » : un refus et un renvoi sur la même
#  adresse (outils/supabase.sql) donnaient l'un ou l'autre au hasard sur
#  Hostinger, et la surveillance attend 404. Les fichiers cachés (.htaccess,
#  .git) restent refusés.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(outils|application-mobile|bureau|docs|\.git|\.github|\.claude)(/|$) - [R=404,L]
  RewriteRule \.(sql|py|md|command|json|lock)$ - [R=404,L]
</IfModule>
<IfModule !mod_rewrite.c>
  <FilesMatch "\.(sql|py|md|command|json|lock)$">
    Require all denied
  </FilesMatch>
</IfModule>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Adresses propres -----------------------------------------------------
#  Le visiteur voit goshipexpress.net/nos-services, pas nos-services.html,
#  et goshipexpress.net/en/, pas en/index.html. Les fichiers gardent leur
#  nom : les liens des pages aussi (ils marchent ainsi sur l'ordinateur, en
#  file:, et sur GitHub Pages). Une adresse en .html est renvoyée une fois
#  vers l'adresse propre (301, que le navigateur retient ensuite), avec ses
#  paramètres (?retour=…) et son ancre (#…, le jeton d'une connexion par
#  e-mail compris).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # THE_REQUEST est l'adresse tapée par le visiteur, pas celle que la règle
  # du bas fabrique : sans cette condition, les deux règles se renverraient
  # la page à l'infini.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\ /([^?\ ]*/)?index(\.html)?[?\ ]
  RewriteRule ^(.*/)?index(\.html)?$ /$1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]+\ /([^?\ ]+)\.html[?\ ]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # nos-services/ (barre en trop) : vers nos-services. Un vrai dossier (en/)
  # garde sa barre.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # L'adresse propre sert le fichier .html du même nom, sans que l'adresse
  # affichée change. Seulement une adresse sans point ni barre finale : le
  # résultat (….html) n'y répond plus, la règle ne peut pas tourner en rond.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]*[^./])$ $1.html [L]
</IfModule>

# --- Cache ----------------------------------------------------------------
#  Les pages, les scripts et les feuilles de style ne portent pas de numéro
#  de version dans leur nom : une copie gardée une semaine montrerait une
#  page neuve avec un script ancien. Le navigateur redemande donc à chaque
#  visite ; s'il n'y a rien de neuf, le serveur répond « 304 » sans renvoyer
#  le fichier. Les images et les polices changent rarement : un jour.
#  (L'ancien WordPress imposait une semaine à tout, un mois aux scripts.)
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  Header unset Expires
  <FilesMatch "\.(html?|js|css|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# --- En-têtes de sécurité -------------------------------------------------
#  Seuls ceux qui ne peuvent rien casser sont actifs. La politique complète
#  (CSP, HSTS, Permissions-Policy, dans _headers) attend un essai page par
#  page : « camera=() » couperait le scan des codes-barres du tableau de
#  bord, et la CSP n'a jamais été essayée sur le site réel.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
