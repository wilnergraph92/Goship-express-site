# ==========================================================================
#  Goship Express — réglages du serveur de goshipexpress.net (Hostinger)
# ==========================================================================
#  Écrit par outils/generateur/build.py (HTACCESS) : changez-le là.
#  Hostinger lit ce fichier à chaque requête ; GitHub Pages l'ignore, et
#  deploy.yml ne l'y envoie pas. Il part sur Hostinger avec le site, par la
#  branche « hostinger » (voir deploy.yml, job « envoyer-hostinger »).
# ==========================================================================

# Une adresse inconnue montre la page « introuvable » du site, pas celle de
# l'hébergeur. Ses liens commencent par « / » : elle s'affiche juste à
# n'importe quelle profondeur (/en/…, /ht/…).
ErrorDocument 404 /404.html

# --- Une seule adresse : goshipexpress.net, sans « www » --------------------
#  www.goshipexpress.net servait les mêmes pages : pour Google, deux sites en
#  double ; pour le client, deux sessions (connecté sur l'un, pas sur l'autre).
#  Renvoi définitif (301), adresse, paramètres et ancre gardés. En premier :
#  les règles suivantes ne voient plus que le domaine nu.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.goshipexpress\.net$ [NC]
  RewriteRule ^ https://goshipexpress.net%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- Les fichiers de travail ne sont jamais servis aux visiteurs ----------
#  Ils ne sont pas envoyés, mais si l'un arrivait par erreur, il resterait
#  caché. Le dossier .git est celui que Hostinger garde pour suivre la
#  branche « hostinger ».
#  Toujours « 404 », jamais « 403 » : un refus et un renvoi sur la même
#  adresse (outils/supabase.sql) donnaient l'un ou l'autre au hasard sur
#  Hostinger, et la surveillance attend 404. Les fichiers cachés (.htaccess,
#  .git) restent refusés.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(outils|application-mobile|bureau|docs|\.git|\.github|\.claude)(/|$) - [R=404,L]
  RewriteRule \.(sql|py|md|command|json|lock)$ - [R=404,L]
</IfModule>
<IfModule !mod_rewrite.c>
  <FilesMatch "\.(sql|py|md|command|json|lock)$">
    Require all denied
  </FilesMatch>
</IfModule>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Adresses propres -----------------------------------------------------
#  Le visiteur voit goshipexpress.net/nos-services, pas nos-services.html,
#  et goshipexpress.net/en/, pas en/index.html. Les fichiers gardent leur
#  nom : les liens des pages aussi (ils marchent ainsi sur l'ordinateur, en
#  file:, et sur GitHub Pages). Une adresse en .html est servie telle
#  quelle, sans renvoi : chaque lien interne en .html coûtait un aller-retour
#  de plus (1 à 2 s sur un téléphone, contrôle qualité du 16/11/2026). Le
#  doublon ne gêne pas Google : chaque page désigne son adresse propre
#  (<link rel="canonical">), et le plan du site ne liste qu'elle.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # nos-services/ (barre en trop) : vers nos-services. Un vrai dossier (en/)
  # garde sa barre.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # L'adresse propre sert le fichier .html du même nom, sans que l'adresse
  # affichée change. Seulement une adresse sans point ni barre finale : le
  # résultat (….html) n'y répond plus, la règle ne peut pas tourner en rond.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]*[^./])$ $1.html [L]
</IfModule>

# --- Cache ----------------------------------------------------------------
#  Les pages ne portent pas de numéro de version : le navigateur les
#  redemande à chaque visite ; s'il n'y a rien de neuf, le serveur répond
#  « 304 » sans renvoyer le fichier. Les images et les polices changent
#  rarement : un jour. (L'ancien WordPress imposait une semaine à tout.)
#
#  Les scripts et les feuilles de style sont appelés par les pages avec leur
#  empreinte (site.css?v=3fa2c19e0b), posée à la publication dans la copie
#  qui part en ligne (deploy.yml, outils/production/versionner.py) : un
#  fichier changé change d'adresse, la copie gardée ne peut donc jamais être
#  ancienne. Ceux-là seulement sont gardés un an. Sans « v= » (un lien écrit
#  à la main, une page ouverte avant la publication), même règle que les
#  pages : rien n'est gardé.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)v=[0-9a-f]{10}(&|$)
  RewriteRule \.(js|css)$ - [E=GS_VERSIONNE:1]
</IfModule>
<IfModule mod_headers.c>
  Header unset Expires
  <FilesMatch "\.(html?|js|css|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=GS_VERSIONNE
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# --- En-têtes de sécurité -------------------------------------------------
#  Seuls ceux qui ne peuvent rien casser sont actifs. La politique complète
#  (CSP, Permissions-Policy, dans _headers) attend un essai page par page :
#  « camera=() » couperait le scan des codes-barres du tableau de bord. La
#  CSP de chaque page est déjà dans la page elle-même (balise meta).
#
#  Strict-Transport-Security : le navigateur qui a vu le site une fois ne
#  l'ouvre plus qu'en https, pendant un an, même si on tape http:// ou si un
#  réseau Wi-Fi piégé tente de le détourner. Sans includeSubDomains : les
#  sous-domaines de Brevo (envoie.…) et ftp.… ne sont pas concernés.
#  Sans preload : rien n'est inscrit dans les navigateurs, la règle reste
#  réversible (max-age=0).
#
#  X-Frame-Options et frame-ancestors : aucun autre site ne peut afficher
#  ces pages dans un cadre. Sans cela, une page piège pouvait montrer le
#  tableau de bord, invisible, sous ses propres boutons, et faire cliquer
#  un membre de l'équipe connecté sans qu'il le sache (« clickjacking »).
#  SAMEORIGIN / 'self' et non DENY : le site garde le droit de s'afficher
#  lui-même. Le cadre d'impression (impression.js) n'est pas concerné : il
#  est rempli par le script, il ne charge aucune page. La CSP de l'en-tête
#  ne porte que frame-ancestors, que la balise meta des pages ne peut pas
#  porter, plus upgrade-insecure-requests que Hostinger envoyait déjà de
#  lui-même (« Forcer HTTPS ») et que cette ligne remplace ; le navigateur
#  applique l'en-tête et la balise meta ensemble.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
