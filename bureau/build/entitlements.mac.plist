<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Droits de l'application de bureau sous le « hardened runtime » (signature Developer ID
  et notarisation, bureau/electron-builder.distribution.js). Le strict nécessaire pour
  qu'Electron (V8) fonctionne : compilation à la volée. Ni caméra, ni micro, ni
  fichiers de l'utilisateur, ni réseau entrant.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
