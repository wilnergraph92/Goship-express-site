# ==========================================================================
#  Goship Express — fichiers que Git doit ignorer
# ==========================================================================
#  Tout ce qui est listé ici reste sur votre ordinateur et ne part jamais
#  sur GitHub : soit parce que c'est reconstructible, soit parce que c'est
#  personnel à votre machine.
# ==========================================================================

# --- macOS ---------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Application mobile : dépendances (461 Mo !) -------------------------
#  Réinstallables à tout moment avec « npm install » dans application-mobile.
application-mobile/node_modules/
application-mobile/.expo/
application-mobile/dist/
application-mobile/web-build/

# --- Application de bureau : dépendances et installateurs construits ----
#  Réinstallables avec « npm install » dans bureau ; les installateurs
#  sortent de GitHub Actions (onglet Actions, « Application de bureau »).
bureau/node_modules/
bureau/dist/

# --- Journaux et fichiers temporaires ------------------------------------
*.log
npm-debug.log*
yarn-error.log*
*.tmp
*~

# --- Réglages locaux d'éditeur -------------------------------------------
.claude/settings.local.json
.vscode/
.idea/

# --- Secrets (par précaution : rien de tel aujourd'hui) ------------------
.env
.env.*
*.key
*.pem

# --- Supabase CLI : état local d'une stack démarrée -----------------------
#  « supabase start » y écrit des secrets de démarrage propres à la machine
#  (dont un docker.env du runtime Edge) : ils ne doivent jamais partir sur
#  GitHub. Le motif couvre tout projet Supabase local du dépôt, notamment
#  outils/communication-center-edge/supabase/.
**/supabase/.temp/
**/supabase/.branches/

# --- Sauvegardes de la base : jamais dans le dépôt ------------------------
#  Elles vivent dans le stockage externe (outils/README-backup.md). Les
#  migrations outils/*.sql, elles, sont versionnées : pas de « *.sql » ici,
#  seulement les formes que prend une sauvegarde.
*.dump
*.backup
*.age
*.age.sha256
*.sql.gz
*.dump.gz
goship-backup/
goship-sauvegarde*/
rclone.conf

# --- Application mobile : elle a son propre dépôt GitHub -----------------
application-mobile/

# --- Audit SEO (skills .claude/skills/seo, keyword-finder, page-writer) ---
#  Le dossier de travail de /seo : pages lues sur notre site et chez les
#  concurrents, export Search Console, rapport. Il naît à la racine, qui est
#  la racine du site publié : il ne doit jamais partir sur GitHub.
seo-work/

# --- Publicités (skills .claude/skills/ads, ad-writer, ad-images) --------
#  Pubs des concurrents, audits, textes et images : le dossier naît à la
#  racine, donc dans le site publié. Il reste sur la machine qui l'a fait.
ads-out/

# --- Réponses de l'IA de Google (skills .claude/skills/search, search-fixer,
#     search-tracker) : questions, réponses lues, avant/après. Même raison.
search-work/

# --- Prospection (skills lead-finder, profile-builder, email-finder, lead-sender,
#     leads, lead-emails, humanizer) : publications, profils, adresses e-mail et
#     lots d'envoi. Ce sont des données personnelles : jamais dans le dépôt, et
#     encore moins sur le site publié.
finder-out/
leads-out/
/queue/
